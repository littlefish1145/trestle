+// Overrides only the elapsed-time input to Ninja's own critical-path heuristic.
+// A mismatch or an unreadable file leaves the usual build-log weight in place.
+void NinjaMain::ApplyTrestleHistory(const char* path) {
+  if (!path)
+    return;
+  std::ifstream stream(path, std::ios::binary);
+  string line;
+  if (!std::getline(stream, line) || line != "trestle-history-v1") {
+    fprintf(stderr, "trestle-history: applied 0\n");
+    return;
+  }
+  std::unordered_map<string, std::unordered_map<uint64_t, int64_t>> weights;
+  while (std::getline(stream, line)) {
+    size_t first = line.find('\t');
+    size_t last = line.rfind('\t');
+    if (first == 0 || first == string::npos || first == last)
+      continue;
+    string hash = line.substr(first + 1, last - first - 1);
+    string millis = line.substr(last + 1);
+    if (hash.empty() || hash.size() > 16 ||
+        hash.find_first_not_of("0123456789abcdefABCDEF") != string::npos ||
+        millis.empty() || millis.size() > 10 ||
+        millis.find_first_not_of("0123456789") != string::npos)
+      continue;
+    uint64_t duration = strtoull(millis.c_str(), NULL, 10);
+    if (duration > INT_MAX)
+      continue;
+    weights[line.substr(0, first)][strtoull(hash.c_str(), NULL, 16)] = duration;
+  }
+  size_t applied = 0;
+  if (stream.eof() && !stream.bad()) {
+    for (Edge* edge : state_.edges_) {
+      if (edge->is_phony() || edge->outputs_.empty())
+        continue;
+      auto output = weights.find(edge->outputs_[0]->path());
+      if (output == weights.end())
+        continue;
+      auto weight = output->second.find(
+          BuildLog::LogEntry::HashCommand(edge->EvaluateCommand(true)));
+      if (weight == output->second.end())
+        continue;
+      edge->prev_elapsed_time_millis = weight->second;
+      ++applied;
+    }
+  }
+  fprintf(stderr, "trestle-history: applied %zu\n", applied);
+}
